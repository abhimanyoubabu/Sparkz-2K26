rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Event posters and background images: publicly readable
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Abheri payment screenshots: uploaded by users, viewed by admins
    match /abheri_payments/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Default fallback
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
